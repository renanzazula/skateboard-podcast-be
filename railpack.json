{
  "$schema": "https://schema.railpack.com",
  "provider": "java",
  "steps": {
    "build": {
      "commands": [
        "chmod +x ./mvnw",
        "./mvnw clean package -DskipTests",
        "cp target/podcast-0.0.1-SNAPSHOT.jar target/app.jar",
        "curl -sL -o newrelic.zip https://download.newrelic.com/newrelic/java-agent/newrelic-agent/8.20.0/newrelic-java.zip",
        "unzip -q newrelic.zip",
        "cp newrelic-config/newrelic.yml newrelic/newrelic.yml"
      ]
    }
  },
  "deploy": {
    "startCommand": "if [ \"$NEW_RELIC_ENABLED\" = \"true\" ]; then java -javaagent:newrelic/newrelic.jar -jar target/app.jar; else java -jar target/app.jar; fi"
  }
}
